[build-system]
requires = ["setuptools>=80", "setuptools-scm>=8"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project_slug }}"
dynamic = ["version"]
description = "{{ project_description }}"
authors = [
    { name = "{{ user_name }}"{% if user_email %}, email = "{{ user_email }}"{% endif %} },
]
readme = "README.md"
requires-python = "==3.13.*"
dependencies = [
    "colorlog>=6.12.0",{% if 'WebServer' in lib_pack %}
    "fastapi>=0.136.3",
    "uvicorn>=0.49.0",{% endif %}{% if 'Data' in lib_pack %}
    "matplotlib>=3.11.0",
    "numpy>=2.4.6",
    "pandas>=3.0.3",{% endif %}{% if 'Dantic' in lib_pack %}
    "pydantic>=2.13.4",{% endif %}{% if 'Serial' in lib_pack %}
    "pyserial>=3.5",{% endif %}{% if 'GUI' in lib_pack %}
    "pyside6>=6.11.1",{% endif %}{% if 'SQL' in lib_pack %}
    "sqlalchemy>=2.0.50",{% endif %}
]

[project.scripts]
main = "{{ module_slug }}.main:main"

# setuptools-scm reads the release tags, or the version CI passes in through the Makefile
[tool.setuptools_scm]
fallback_version = "0.0.0"

[tool.setuptools.packages.find]
include = ["{{ module_slug }}*"]

[tool.uv]
package = true
# rebuild the installed project when the version changes, so its metadata stays current
cache-keys = [
    { file = "pyproject.toml" },
    { git = { commit = true, tags = true } },
    { env = "SETUPTOOLS_SCM_PRETEND_VERSION" },
]

[dependency-groups]
dev = [
    "pytest>=9.1.1",
    "ruff>=0.17.1",
]
